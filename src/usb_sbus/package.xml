<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usb_sbus</name>
  <version>1.1.5</version>
  <description>The usb_sbus collects messages from the sbus, and publishes a summary of their data in a friendlier message format.</description>
  <maintainer email="james.zhang@ubtrobot.com">Devon Ash</maintainer>
  <license>BSD</license>
  <author>james.zhang</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
